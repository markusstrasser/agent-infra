{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/Users/alien/Projects/agent-infra/scripts/control-plane-surface.sh"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/Users/alien/Projects/agent-infra/.claude/hooks/userprompt-clash-capture.py"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "APPENDONLY_PATHS='improvement-log\\.md|decisions/' APPENDONLY_MSG='improvement-log.md and decisions/ are append-only. Mark stale, do not delete.' ~/Projects/skills/hooks/pretool-append-only-guard.sh"
          },
          {
            "type": "command",
            "command": "~/Projects/skills/hooks/pretool-prebuild-inventory-shadow.py",
            "async": true
          }
        ]
      },
      {
        "matcher": "mcp__exa__web_search_advanced_exa",
        "hooks": [
          {
            "type": "command",
            "command": "~/Projects/agent-infra/scripts/pretool_exa_cap.py"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "mcp__research__fetch_paper|mcp__research__get_paper",
        "hooks": [
          {
            "type": "command",
            "command": "cd /Users/alien/Projects/agent-infra && uv run python3 scripts/posttool-paper-quality.py"
          }
        ]
      },
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "fp=$(cat | python3 -c \"import sys,json; print(json.load(sys.stdin).get('tool_input',{}).get('file_path',''))\" 2>/dev/null) || exit 0\ncase \"$fp\" in\n  */agent-infra/research/*.md)\n    cd /Users/alien/Projects/agent-infra && uv run python3 scripts/generate-indexes.py --fix > /dev/null 2>&1 &\n    ;;\nesac\nexit 0"
          },
          {
            "type": "command",
            "command": "$HOME/Projects/skills/hooks/posttool-codebase-map.sh"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/Users/alien/Projects/skills/hooks/stop-unsupported-completion.sh",
            "async": true
          },
          {
            "type": "command",
            "command": "/Users/alien/Projects/skills/hooks/stop-smart-judge.sh",
            "async": true
          },
          {
            "type": "command",
            "command": "/Users/alien/Projects/skills/hooks/stop-corpus-drain-health.sh",
            "async": true
          },
          {
            "type": "command",
            "command": "/Users/alien/Projects/agent-infra/.claude/hooks/stop-stance-flip-shadow.sh",
            "async": true
          },
          {
            "type": "command",
            "command": "/Users/alien/Projects/skills/hooks/stop-answer-length-shadow.py",
            "async": true
          },
          {
            "type": "command",
            "command": "/Users/alien/Projects/skills/hooks/plan-close-gate.py"
          }
        ]
      }
    ]
  }
}
