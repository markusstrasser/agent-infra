<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.agent-infra.codebase-map-refresh</string>
    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>/Users/alien/Projects/agent-infra/scripts/refresh-codebase-maps.sh</string>
    </array>
    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/Users/alien/.local/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
        <key>HOME</key>
        <string>/Users/alien</string>
    </dict>
    <key>WorkingDirectory</key>
    <string>/Users/alien/Projects/agent-infra</string>
    <!-- @system layer=watch role=sync llm=none
         Event-triggered: WatchPaths on the mapped source dirs (fires on direct
         child add/remove/rename — content-only edits don't bump a dir's mtime,
         and agent-infra's own PostToolUse index hook covers those for this repo).
         Weekly StartInterval backstop catches what the watch misses; the refresh
         is idempotent, so extra fires produce no git churn. -->
    <key>WatchPaths</key>
    <array>
        <string>/Users/alien/Projects/agent-infra/scripts</string>
        <string>/Users/alien/Projects/intel/tools</string>
        <string>/Users/alien/Projects/intel/analysis</string>
        <string>/Users/alien/Projects/research-mcp/src</string>
        <string>/Users/alien/Projects/genomics/scripts</string>
        <string>/Users/alien/Projects/phenome/scripts</string>
        <string>/Users/alien/Projects/phenome/src</string>
    </array>
    <key>StartInterval</key>
    <integer>604800</integer>
    <key>ThrottleInterval</key>
    <integer>600</integer>
    <key>StandardOutPath</key>
    <string>/Users/alien/.claude/logs/codebase-map-refresh.out</string>
    <key>StandardErrorPath</key>
    <string>/Users/alien/.claude/logs/codebase-map-refresh.err</string>
    <key>LowPriorityIO</key>
    <true/>
    <key>Nice</key>
    <integer>5</integer>
</dict>
</plist>
