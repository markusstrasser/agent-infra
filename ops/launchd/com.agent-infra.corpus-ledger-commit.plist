<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.agent-infra.corpus-ledger-commit</string>
    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>/Users/alien/Projects/agent-infra/scripts/corpus-ledger-commit.sh</string>
    </array>
    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
        <key>HOME</key>
        <string>/Users/alien</string>
        <key>CORPUS_ROOT</key>
        <string>/Users/alien/Projects/corpus</string>
    </dict>
    <key>WorkingDirectory</key>
    <string>/Users/alien/Projects/corpus</string>
    <!-- Event-tie + clock backstop. WatchPaths fires on a new source dir landing
         under the corpus root (a new sha_*/ child bumps the root's mtime) — the
         bulk of ledger changes are fresh ingests, now committed same-day. It does
         NOT catch in-place re-annotation of an existing source: annotations.jsonl
         sits at depth 2 (corpus/sha_*/annotations.jsonl) and WatchPaths is
         non-recursive. The daily 05:00 clock stays as the backstop for those.
         Idempotent (git diff --cached --quiet → exit 0), so extra fires are free. -->
    <key>WatchPaths</key>
    <array>
        <string>/Users/alien/Projects/corpus</string>
    </array>
    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key>
        <integer>5</integer>
        <key>Minute</key>
        <integer>0</integer>
    </dict>
    <key>ThrottleInterval</key>
    <integer>600</integer>
    <key>StandardOutPath</key>
    <string>/Users/alien/.claude/logs/corpus/corpus-ledger-commit.out</string>
    <key>StandardErrorPath</key>
    <string>/Users/alien/.claude/logs/corpus/corpus-ledger-commit.err</string>
    <key>LowPriorityIO</key>
    <true/>
    <key>Nice</key>
    <integer>5</integer>
</dict>
</plist>
