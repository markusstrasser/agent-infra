<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.agent-infra.blindspot-miner</string>
    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>/Users/alien/Projects/agent-infra/scripts/blindspot-miner.sh</string>
    </array>
    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/Users/alien/.local/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
        <key>HOME</key>
        <string>/Users/alien</string>
    </dict>
    <key>WorkingDirectory</key>
    <string>/Users/alien/Projects/agent-infra</string>
    <!-- @system layer=watch role=miner llm=none
         Daily 06:50 (after drift-sentinel 06:35) RSI detector: emb-contrastive over
         recent sessions surfaces the moments the human had to catch a loop miss, so
         each becomes a candidate detector. Runs in emb's env (no torch in
         agent-infra), $0 local. Writes .claude/blindspot-digest.md (removed when no
         flags); next agent-infra SessionStart surfaces it via blindspot-surface.sh.
         Decouples the RSI loop from interactive /improve — the loop notices its own
         misses across no-loop days. -->
    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key>
        <integer>6</integer>
        <key>Minute</key>
        <integer>50</integer>
    </dict>
    <key>StandardOutPath</key>
    <string>/Users/alien/.claude/logs/blindspot-miner.out</string>
    <key>StandardErrorPath</key>
    <string>/Users/alien/.claude/logs/blindspot-miner.err</string>
    <key>LowPriorityIO</key>
    <true/>
    <key>Nice</key>
    <integer>5</integer>
</dict>
</plist>
