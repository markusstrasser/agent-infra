<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.agent-infra.maintain-tick</string>
    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>/Users/alien/Projects/agent-infra/scripts/maintain-tick.sh</string>
    </array>
    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/Users/alien/.local/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
        <key>HOME</key>
        <string>/Users/alien</string>
    </dict>
    <key>WorkingDirectory</key>
    <string>/Users/alien/Projects/agent-infra</string>
    <!-- The MOTOR half of the RSI loop, SAFE/dry-run. Picks ONE tier-0
         (agent-infra-local + reversible + evidence>=2) candidate and writes a
         DRAFT proposal to artifacts/maintain/<date>-<slug>.md. It does NOT edit
         code, commit, or deploy. Rate-gates on a live-`claude` cap so it never
         races an interactive session. Ledger: maintenance-actions.jsonl.
         StartInterval 2700s (45 min). The apply lane is double-gated OFF
         (--apply AND MAINTAIN_APPLY_ENABLED) and is NOT passed here.
         NOT LOADED until operator runs: launchctl load (see builder manifest). -->
    <key>StartInterval</key>
    <integer>2700</integer>
    <key>StandardOutPath</key>
    <string>/Users/alien/.claude/logs/maintain-tick.out</string>
    <key>StandardErrorPath</key>
    <string>/Users/alien/.claude/logs/maintain-tick.err</string>
    <key>LowPriorityIO</key>
    <true/>
    <key>Nice</key>
    <integer>5</integer>
</dict>
</plist>
