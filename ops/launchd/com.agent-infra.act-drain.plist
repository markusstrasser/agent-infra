<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.agent-infra.act-drain</string>
    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>/Users/alien/Projects/agent-infra/scripts/act-drain.sh</string>
    </array>
    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/Users/alien/.local/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
        <key>HOME</key>
        <string>/Users/alien</string>
    </dict>
    <key>WorkingDirectory</key>
    <string>/Users/alien/Projects/agent-infra</string>
    <!-- Daily 06:45 (after drift-sentinel 06:35): zero-LLM ACT drain — runs
         reflect classify + ranks disposition queue. Writes
         ~/.claude/act-drain-digest.md when attention needed; removed when green.
         SessionStart surfaces via act-drain-surface.sh. -->
    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key>
        <integer>6</integer>
        <key>Minute</key>
        <integer>45</integer>
    </dict>
    <key>StandardOutPath</key>
    <string>/Users/alien/.claude/logs/act-drain.out</string>
    <key>StandardErrorPath</key>
    <string>/Users/alien/.claude/logs/act-drain.err</string>
    <key>LowPriorityIO</key>
    <true/>
    <key>Nice</key>
    <integer>5</integer>
</dict>
</plist>
